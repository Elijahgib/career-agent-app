# ─────────────────────────────────────────────────────────────
# Career Agent App — environment configuration
# Copy to `.env` and adjust. Never commit `.env`.
# Everything works with NO keys: the app falls back to the
# deterministic template engine and offline demo job data.
# ─────────────────────────────────────────────────────────────

# Local SQLite database (path relative to the project root).
# For PostgreSQL later, see docs/ARCHITECTURE.md ("Moving to Postgres").
DATABASE_URL="file:./prisma/dev.db"

# AI provider for optional bullet/summary rewording.
#   template  — deterministic, offline, no data leaves the machine (default)
#   anthropic — Anthropic Messages API (requires ANTHROPIC_API_KEY)
#   openai    — any OpenAI-compatible chat endpoint (OpenAI, Ollama, LM Studio…)
# Whatever provider is used, every output passes through the Truth Gate.
AI_PROVIDER="template"

# Anthropic (only read when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"

# OpenAI-compatible (only read when AI_PROVIDER=openai)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# Live job-source fetching (Greenhouse / Lever / Ashby / employer career pages).
# Off by default so the app never makes outbound requests unless you opt in.
JOB_SOURCES_NETWORK="off"   # "on" to allow outbound fetches to public ATS endpoints
JOB_FETCH_TIMEOUT_MS="10000"
JOB_FETCH_USER_AGENT="career-agent-app/0.1 (+local; personal job search)"

# Email connector (architecture only in v0.1 — see docs/PRIVACY.md)
EMAIL_CONNECTOR="mock"      # mock | gmail (not implemented) | outlook (not implemented)

# Next.js telemetry is disabled by scripts/next.mjs; this also covers direct `npx next` use.
NEXT_TELEMETRY_DISABLED="1"
